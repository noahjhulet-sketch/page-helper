{
  "manifest_version": 3,
  "name": "Page Helper",
  "version": "0.1.0",
  "description": "Summarize pages, answer fill-in-the-blank questions, find similar sources, and ask questions about what you're reading.",
  "permissions": ["sidePanel", "scripting", "storage", "contextMenus", "tabs"],
  "host_permissions": ["<all_urls>", "https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_page": "options.html",
  "action": { "default_title": "Open Page Helper" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P" }
    }
  }
}
